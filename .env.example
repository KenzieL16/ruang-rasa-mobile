# RUANG RASA MOBILE - ENVIRONMENT TEMPLATE

# Base URL API Backend (Bisa diakses dari client Expo dengan prefix EXPO_PUBLIC_)
EXPO_PUBLIC_API_URL=http://localhost:5000/api
EXPO_PUBLIC_API_PORT=5000
EXPO_PUBLIC_LOCAL_IP=your_ip

JWT_SECRET=your_jwt_secret_key_here
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=your_admin_password_here

# LogRocket Analytics
EXPO_PUBLIC_LOGROCKET_APP_ID=your_logrocket_app_id_here

